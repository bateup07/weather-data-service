# Database
DATABASE_URL=jdbc:h2:mem:weather;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
DATABASE_DRIVER=org.h2.Driver

# Open-Meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com

# HTTP timeouts
WEATHER_CONNECT_TIMEOUT_MS=500
WEATHER_RESPONSE_TIMEOUT_MS=1500